# Copy to .env.local and fill in. Never commit real secrets.

# Signs session cookies. Use a long random value in every environment.
SESSION_SECRET=change-me-to-a-long-random-string

# Branding shown across the site
NEXT_PUBLIC_BRAND_NAME=Luxenbourg Wealth
NEXT_PUBLIC_ARN=ARN-000000

# AI assistant. Leave unset to use the built-in offline assistant (same tools, rule-based replies).
# ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# AI_MODEL=claude-opus-5-5

# Hours after which synced data is labelled stale
STALE_AFTER_HOURS=24
